PROJECT_NAME=IT News Platform
APP_ENV=local
API_V1_PREFIX=/api/v1
BACKEND_PORT=8000
FRONTEND_PORT=3000
LOG_LEVEL=INFO

POSTGRES_DB=itnews
POSTGRES_USER=itnews
POSTGRES_PASSWORD=itnews
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

ENABLE_SCHEDULER=true
INGESTION_INTERVAL_MINUTES=30
EMBEDDING_INDEX_INTERVAL_MINUTES=5
CLUSTERING_INTERVAL_MINUTES=30
ENABLE_NEWS_API=false
NEWS_API_URL=https://newsapi.org/v2/everything
NEWS_API_KEY=
NEWS_API_QUERY=technology OR cybersecurity OR software

DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=ru,en
ALLOWED_RSS_SOURCES=https://habr.com/ru/rss/all/all/?fl=ru,https://3dnews.ru/news/rss/,https://www.opennet.ru/opennews/opennews_all_utf.rss,https://www.cnews.ru/inc/rss/news.xml,https://techcrunch.com/category/artificial-intelligence/feed/,https://techcrunch.com/feed/,https://feeds.arstechnica.com/arstechnica/technology-lab,https://www.theverge.com/rss/index.xml,https://www.wired.com/feed/category/gear/latest/rss
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSION=384
EMBEDDING_MAX_CHARS=4000
EMBEDDING_MAX_RETRIES=3
CLUSTERING_HDBSCAN_THRESHOLD=50
CLUSTERING_MIN_CLUSTER_SIZE=5
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL_PRIMARY=llama-3.3-70b-versatile
GROQ_MODEL_FALLBACK=llama-3.1-8b-instant
GROQ_MODEL_FAST=llama-3.1-8b-instant
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_TIMEOUT_SECONDS=45
RAG_TOP_K=5
GRAPH_MAX_ENTITIES=15
GRAPH_MAX_RELATIONS=20
RAG_MAX_ARTICLE_SNIPPET_CHARS=700
RAG_CONTEXT_TOKEN_BUDGET=8000
